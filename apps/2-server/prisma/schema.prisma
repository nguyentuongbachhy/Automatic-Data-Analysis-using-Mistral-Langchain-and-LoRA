generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Định nghĩa các enum để đảm bảo tính nhất quán
enum ResponseStatus {
  SUCCESS
  ERROR
  PENDING
}

enum InsightType {
  CORRELATION
  TREND
  DISTRIBUTION
  OUTLIER
  SUMMARY
  PATTERN
  ANOMALY
  COMPARISON
  LIKERT
  BINARY
  GENDER
  RANGE
  TEXT
}

enum ChartType {
  LINE
  BAR
  SCATTER
  PIE
  HISTOGRAM
  GROUPED_HISTOGRAM
  BOX
  HEATMAP
  AREA
  BUBBLE
  RADAR
  COMBO
  WATERFALL
  TREEMAP
  SANKEY
  LIKERT
  WORD_CLOUD
  RANGE
  TEXT
  LIKERT_CORRELATION
  BAR_GROUPED
  VIOLIN
  MOSAIC
  SCATTER_3D
  CHORD
  FACET
  GANTT
  DONUT
  HEXBIN
  NETWORK
  ANIMATION
  DIVERGING
  MATRIX
  REGRESSION
}

enum MessageRole {
  SYSTEM
  USER
  ASSISTANT
}

enum IntentType {
  QUESTION
  VISUALIZATION
  ANALYSIS
  INSIGHT
  PREDICTION
  UNKNOWN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt String
  updatedAt String
  chats     Chat[]
  files     File[]
}

model File {
  id                 String               @id @default(uuid())
  filename           String
  originalName       String
  type               String
  size               Int
  path               String
  userId             String
  qualityScore       Float?
  isPending          Boolean              @default(false)
  createdAt          String
  updatedAt          String
  analysis           Analysis?
  chats              Chat[]
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  columns            FileColumn[]
  insights           Insight[]
  predictions        Prediction[]
  timeSeriesAnalyses TimeSeriesAnalysis[]
  visualizations     Visualization[]
  chartRecommendations ChartRecommendation[]
}

model FileColumn {
  id           String   @id @default(uuid())
  fileId       String
  name         String
  displayName  String?
  type         String
  stats        Json
  quality      Float?
  completeness Float?
  nullable     Boolean  @default(true)
  createdAt    String
  updatedAt    String
  file         File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, name])
}

model Analysis {
  id                 String   @id @default(uuid())
  fileId             String   @unique
  rowCount           Int
  columnCount        Int
  missingValues      Int      // From dataset_info.missing_values.count
  duplicateRows      Int
  outliers           Int
  
  datasetInfo        Json?    // Store dataset_info as JSON
  statisticalAnalysis Json?   // Store statistical_analysis as JSON
  advancedAnalysis   Json?    // Store advanced_analysis if needed
  
  qualityMetrics     Json?    // Store data_quality.quality_metrics
  summary            Json
  dataQuality        Json?    // Maps to data_quality
  recommendations    Json?    // Maps to recommendations
  
  createdAt          String
  updatedAt          String
  file               File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
}

model Insight {
  id            String      @id @default(uuid())
  fileId        String
  type          InsightType // Using enum
  title         String
  content       String
  importance    Float       // Changed from Int to Float to match analysis.py
  sourceType    String?     // Nguồn của insight (manual, ml, statistical)
  columns       String[]    @default([])
  relatedCharts String[]    @default([])
  metadata      Json?
  createdAt     String
  updatedAt     String
  file          File        @relation(fields: [fileId], references: [id], onDelete: Cascade)
}

model Visualization {
  id              String    @id @default(uuid())
  fileId          String
  type            ChartType // Using enum
  title           String
  description     String?
  config          Json
  data            Json
  parameters      Json?     // Tham số để tái tạo visualization
  chartLibrary    String?   // Thư viện sử dụng (echarts, recharts, etc.)
  insight         String?
  recommendedType String?
  relatedInsights String[]  @default([])
  isCustom        Boolean   @default(false)
  createdAt       String
  updatedAt       String
  file            File      @relation(fields: [fileId], references: [id], onDelete: Cascade)
}

model ChartRecommendation {
  id               String   @id @default(uuid())
  fileId           String
  columns          String[] @default([])
  recommendations  Json
  bestCharts       Json?
  createdAt        String
  updatedAt        String
  file             File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
}

model Chat {
  id           String    @id @default(uuid())
  userId       String
  fileId       String?
  title        String    @default("New Chat") // Trường mới
  createdAt    String
  updatedAt    String
  isArchived   Boolean   @default(false)      // Trường mới
  lastMessage  String?                        // Trường mới
  file         File?     @relation(fields: [fileId], references: [id])
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     Message[]
}

model Message {
  id        String      @id @default(uuid())
  chatId    String
  role      MessageRole // Using enum
  content   String
  metadata  Json?
  createdAt String
  updatedAt String
  chat      Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model TimeSeriesAnalysis {
  id               String   @id @default(uuid())
  fileId           String
  dateColumn       String
  valueColumn      String
  results          Json
  forecastIncluded Boolean  @default(false)
  forecastPeriods  Int?
  createdAt        String
  updatedAt        String
  file             File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, dateColumn, valueColumn])
}

model Prediction {
  id             String   @id @default(uuid())
  fileId         String
  targetColumn   String
  featureColumns String[] @default([])
  modelType      String
  config         Json
  results        Json
  metrics        Json
  testSize       Float?   // Tỷ lệ dữ liệu test
  importance     Json?    // Feature importance
  visualization  Json?
  createdAt      String
  updatedAt      String
  file           File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
}
