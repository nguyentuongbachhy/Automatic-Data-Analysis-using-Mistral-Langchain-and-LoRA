{
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
        "standard": {
            "format": "%(asctime)s [%(levelname)s] %(name)s: %(message)s",
            "datefmt": "%Y-%m-%d %H:%M:%S"
        },
        "detailed": {
            "format": "%(asctime)s [%(levelname)s] %(name)s:%(lineno)d: %(message)s",
            "datefmt": "%Y-%m-%d %H:%M:%S"
        },
        "json": {
            "format": "%(asctime)s %(levelname)s %(name)s %(message)s",
            "datefmt": "%Y-%m-%d %H:%M:%S",
            "class": "pythonjsonlogger.jsonlogger.JsonFormatter"
        }
    },
    "handlers": {
        "console": {
            "class": "logging.StreamHandler",
            "level": "INFO",
            "formatter": "standard",
            "stream": "ext://sys.stdout"
        },
        "file": {
            "class": "logging.handlers.RotatingFileHandler",
            "level": "DEBUG",
            "formatter": "detailed",
            "filename": "logs/ai-service.log",
            "maxBytes": 10485760,
            "backupCount": 5,
            "encoding": "utf8"
        },
        "error_file": {
            "class": "logging.handlers.RotatingFileHandler",
            "level": "ERROR",
            "formatter": "detailed",
            "filename": "logs/error.log",
            "maxBytes": 10485760,
            "backupCount": 5,
            "encoding": "utf8"
        },
        "model_file": {
            "class": "logging.handlers.RotatingFileHandler",
            "level": "INFO",
            "formatter": "detailed",
            "filename": "logs/model.log",
            "maxBytes": 10485760,
            "backupCount": 3,
            "encoding": "utf8"
        },
        "performance_file": {
            "class": "logging.handlers.RotatingFileHandler",
            "level": "INFO",
            "formatter": "json",
            "filename": "logs/performance.log",
            "maxBytes": 10485760,
            "backupCount": 3,
            "encoding": "utf8"
        }
    },
    "loggers": {
        "": {
            "level": "INFO",
            "handlers": [
                "console",
                "file"
            ],
            "propagate": true
        },
        "app": {
            "level": "DEBUG",
            "handlers": [
                "console",
                "file"
            ],
            "propagate": false
        },
        "ml": {
            "level": "INFO",
            "handlers": [
                "console",
                "file",
                "model_file"
            ],
            "propagate": false
        },
        "ml.model": {
            "level": "DEBUG",
            "handlers": [
                "console",
                "file",
                "model_file"
            ],
            "propagate": false
        },
        "app.core.monitoring": {
            "level": "INFO",
            "handlers": [
                "performance_file"
            ],
            "propagate": true
        },
        "uvicorn": {
            "level": "INFO",
            "handlers": [
                "console",
                "file"
            ],
            "propagate": false
        },
        "uvicorn.error": {
            "level": "INFO",
            "handlers": [
                "console",
                "error_file"
            ],
            "propagate": false
        },
        "uvicorn.access": {
            "level": "INFO",
            "handlers": [
                "console"
            ],
            "propagate": false
        }
    }
}